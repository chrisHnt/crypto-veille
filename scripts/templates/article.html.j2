<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ titre }} — Veille Crypto</title>
  <link rel="stylesheet" href="../style.css">
</head>
<body>
  <header>
    <a href="../index.html" class="back">&larr; Tous les articles</a>
  </header>
  <main>
    <article>
      <h1>{{ titre }}</h1>
      <p class="meta">{{ date }}</p>
      <p class="ai-notice">Chaque affirmation de cet article a été vérifiée fait par fait par une recherche web indépendante avant publication (rédaction assistée par IA) — voir <a href="../index.html#a-propos">notre méthode</a>.</p>
      {{ contenu_html | safe }}
      <section class="sources">
        <h2>Sources</h2>
        <ul>
          {% for source in sources %}
          <li><a href="{{ source.link }}" target="_blank" rel="noopener noreferrer">{{ source.source }}</a></li>
          {% endfor %}
        </ul>
      </section>
    </article>
  </main>
  <footer>
    <p>Article généré et vérifié automatiquement (Mistral + Perplexity).</p>
    <p>Contenu sous licence <a href="https://creativecommons.org/licenses/by-nc/4.0/deed.fr" target="_blank" rel="noopener noreferrer">Creative Commons BY-NC 4.0</a> — réutilisation libre hors usage commercial, sous réserve de citer la source avec un lien.</p>
  </footer>
</body>
</html>
